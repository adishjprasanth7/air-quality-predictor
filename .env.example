# Local FastAPI configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Local development database. Render supplies its PostgreSQL DATABASE_URL.
DATABASE_URL=sqlite:///./air_quality.db
SESSION_COOKIE_SECURE=false

# Model and city-data paths
MODEL_PATH=backend/model/air_quality_model.pkl
MODEL_INFO_PATH=backend/model/model_info.json
CITIES_DATA_PATH=backend/data/cities_pollution_summary.json
